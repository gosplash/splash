module invoice
expose Totals, invoice_totals

type Totals {
    subtotal: Int
    discount: Int
    due: Int
}

fn invoice_totals(quantity: Int, unit_cents: Int, discount_percent: Int) -> Totals {
    let subtotal = quantity * unit_cents
    let numerator = subtotal * discount_percent
    let whole = numerator / 100
    if numerator % 100 >= 50 {
        let discount = whole + 1
        return Totals { subtotal: subtotal, discount: discount, due: subtotal - discount }
    }
    return Totals { subtotal: subtotal, discount: whole, due: subtotal - whole }
}
