// @containment example.
// Demonstrates: module-level agent lockout policies.
//
// @containment checks resolved agent reachability against the owning module's
// policy.
//
// Three policies:
//   @containment(agent: "none")           — agents can't touch this module
//   @containment(agent: "read_only")      — agents can call read functions only
//   @containment(agent: "approved_only")  — agent calls require approve fn or @agent_allowed

@containment(agent: "approved_only")
module billing

// approve fn provides permission under "approved_only" containment. Generated
// Go invokes the ApprovalAdapter before running the gated function body.
approve fn charge_customer(customer_id: Int, amount_cents: Int) needs DB.write, Net {
    let charged = amount_cents
}

// Read calls also need permission under "approved_only" containment.
approve fn get_balance(customer_id: Int) needs DB.read -> Int {
    return 0
}

// Internal helper — not an agent entry point.
fn is_valid_amount(amount_cents: Int) -> Bool {
    if amount_cents > 0 {
        return true
    }
    return false
}
